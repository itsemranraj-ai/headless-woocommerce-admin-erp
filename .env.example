# ==============================================================================
# HEADLESS WOOCOMMERCE ADMIN ERP - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Store Admin ERP"
NEXT_PUBLIC_APP_DESCRIPTION="Real-time Headless WooCommerce Admin & Order Management"
NEXT_PUBLIC_APP_URL="https://admin.yourdomain.com"
NEXT_PUBLIC_STORE_NAME="My Online Store"
NEXT_PUBLIC_STORE_URL="https://yourstore.com"

# ------------------------------------------------------------------------------
# 2. WOOCOMMERCE REST API CREDENTIALS
# Generate from: WP Admin -> WooCommerce -> Settings -> Advanced -> REST API
# Permissions: Read/Write
# ------------------------------------------------------------------------------
WOOCOMMERCE_API_URL="https://yourstore.com/wp-json/wc/v3"
WOOCOMMERCE_CONSUMER_KEY="ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WOOCOMMERCE_CONSUMER_SECRET="cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WOOCOMMERCE_WEBHOOK_SECRET="your_custom_webhook_secret_key_here"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# Generate a strong 32+ character random string for JWT secret
# ------------------------------------------------------------------------------
JWT_SECRET="generate_a_random_32_character_secret_key_here"
MASTER_PASSCODE="AdminMaster2026!#"

# ------------------------------------------------------------------------------
# 4. WEB PUSH NOTIFICATIONS (Optional - VAPID Keys)
# Generate using: npx web-push generate-vapid-keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# ------------------------------------------------------------------------------
# 5. WHATSAPP & EMAIL AUTOMATIONS (Optional)
# ------------------------------------------------------------------------------
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM="orders@yourdomain.com"
